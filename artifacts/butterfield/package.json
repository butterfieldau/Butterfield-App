{
  "name": "@workspace/butterfield",
  "version": "1.4.1",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "@types/react",
        "@types/react-dom"
      ]
    }
  },
  "scripts": {
    "dev": "CI=1 EXPO_OFFLINE=1 IS_POS_BUILD=1 EXPO_NO_TELEMETRY=1 EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_EXPO_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT --clear",
    "build": "node scripts/build.js",
    "ios:build:testflight": "EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform ios --profile production --clear-cache",
    "ios:submit:testflight": "eas submit --platform ios --profile production",
    "postinstall": "node scripts/patch-stripe-ios.js",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
