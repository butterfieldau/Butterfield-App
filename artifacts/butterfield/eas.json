{
  "cli": {
    "version": ">= 14.0.0",
    "requireCommit": false,
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "app.butterfieldcookies.com.au"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "app.butterfieldcookies.com.au"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "app.butterfieldcookies.com.au",
        "IS_POS_BUILD": "0"
      },
      "ios": {
        "distribution": "store",
        "image": "latest"
      }
    },
    "production-pos": {
      "autoIncrement": true,
      "channel": "production-pos",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "app.butterfieldcookies.com.au",
        "IS_POS_BUILD": "1"
      },
      "ios": {
        "distribution": "store",
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6768331805"
      }
    }
  }
}
